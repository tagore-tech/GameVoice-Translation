# ============================================================
# GameVoice Translator — Environment Configuration Template
# Copy this file to backend/.env and fill in the values.
# NEVER commit backend/.env to version control.
# ============================================================

# ---------------------------
# Server
# ---------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Frontend origin(s) allowed for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ---------------------------
# Provider Selection
# ---------------------------
# Controls which concrete implementation is loaded.
# Switching provider only requires changing the value here —
# no application code changes needed.
#
# STT_PROVIDER options:
#   mock            — returns hardcoded text, no API key required (default for dev/tests)
#   gemini          — real STT via Gemini API (GEMINI_API_KEY required)
STT_PROVIDER=mock

# TRANSLATION_PROVIDER options:
#   mock            — placeholder text, no API key required (default for development)
#   gemini          — Gemini text translation (RECOMMENDED; reuses GEMINI_API_KEY)
#   deep_translator — unofficial Google Translate wrapper, no key, rate-limited
TRANSLATION_PROVIDER=mock

# TTS_PROVIDER options:
#   mock            — returns silence/empty audio, no API key required
#   gtts            — gTTS (free, uses Google Translate TTS endpoint)
#   google          — Google Cloud Text-to-Speech (higher quality)
TTS_PROVIDER=gtts

# ---------------------------
# Language Configuration (PRE-M5)
# ---------------------------
# SOURCE_LANGUAGE: BCP-47 code for what this player speaks (mic input)
# TARGET_LANGUAGE: BCP-47 code for what language they want to hear (M5 translation target)
# Supported values: en (English), hi (Hindi), te (Telugu), ta (Tamil)
# Defaults preserve M4 English-only behavior.
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=en

# ---------------------------
# Gemini API
# ---------------------------
# Required for:
#   STT_PROVIDER=gemini        (Gemini Live real-time transcription)
#   TRANSLATION_PROVIDER=gemini (Gemini text translation)
# Get a free API key at: https://aistudio.google.com/app/apikey
# NEVER commit this file with a real key.
# ---------------------------
# GEMINI_API_KEY=AIza...your-key-here
# GEMINI_STT_MODEL=gemini-3.5-transcribe-live
# GEMINI_STT_AUTO_DETECT=false
# GEMINI_TRANSLATION_MODEL=gemini-2.0-flash

# ---------------------------
# Google Cloud (optional — future providers)
# Required only if using google Cloud STT / translation / TTS providers.
# ---------------------------
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-project-id

# ---------------------------
# Deepgram (optional — future provider)
# Required only if STT_PROVIDER=deepgram
# ---------------------------
# DEEPGRAM_API_KEY=your-key-here
